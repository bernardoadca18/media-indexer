      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-media_indexer}
      POSTGRES_DB: ${POSTGRES_DB:-media_indexer}
    ports: ["5435:5432"]
    volumes: [media-indexer-db-data:/var/lib/postgresql/data]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-media_indexer} -d ${POSTGRES_DB:-media_indexer}"]
      interval: 5s
      timeout: 5s
      retries: 10
  api:
    build: ./backend
    restart: unless-stopped
    env_file:
      - path: .env
        required: false
    environment:
      DATABASE_URL: ${DATABASE_URL:-postgresql+asyncpg://media_indexer:media_indexer@db:5432/media_indexer}
      STORAGE_ROOT: ${STORAGE_ROOT:-/data/storage}
      WORKER_ENABLED: ${WORKER_ENABLED:-true}
      JOB_STALE_TIMEOUT_SECONDS: ${JOB_STALE_TIMEOUT_SECONDS:-300}
      JOB_HEARTBEAT_INTERVAL_SECONDS: ${JOB_HEARTBEAT_INTERVAL_SECONDS:-30}
      JOB_MAX_ATTEMPTS: ${JOB_MAX_ATTEMPTS:-3}
      TRANSCRIPTION_BATCH_SIZE: ${TRANSCRIPTION_BATCH_SIZE:-25}
      WHISPER_MODEL: ${WHISPER_MODEL:-small}
      WHISPER_DEVICE: ${WHISPER_DEVICE:-auto}
      WHISPER_COMPUTE_TYPE: ${WHISPER_COMPUTE_TYPE:-auto}
      WHISPER_LANGUAGE: ${WHISPER_LANGUAGE:-}
      WHISPER_BEAM_SIZE: ${WHISPER_BEAM_SIZE:-5}
      WHISPER_VAD_FILTER: ${WHISPER_VAD_FILTER:-true}
      WHISPER_WORD_TIMESTAMPS: ${WHISPER_WORD_TIMESTAMPS:-true}
      HF_HOME: /data/models/huggingface
      FFPROBE_BINARY: ${FFPROBE_BINARY:-ffprobe}
      FFMPEG_BINARY: ${FFMPEG_BINARY:-ffmpeg}
      VISUAL_INDEX_BATCH_SIZE: ${VISUAL_INDEX_BATCH_SIZE:-25}
      SCENE_DETECTION_ENABLED: ${SCENE_DETECTION_ENABLED:-true}
      SCENE_DETECTOR: ${SCENE_DETECTOR:-ffmpeg_scdet}
      SCENE_THRESHOLD: ${SCENE_THRESHOLD:-10.0}
      REPRESENTATIVE_FRAME_INTERVAL_SECONDS: ${REPRESENTATIVE_FRAME_INTERVAL_SECONDS:-10.0}
      REPRESENTATIVE_FRAME_WIDTH: ${REPRESENTATIVE_FRAME_WIDTH:-640}
      REPRESENTATIVE_FRAME_FORMAT: ${REPRESENTATIVE_FRAME_FORMAT:-jpeg}
      REPRESENTATIVE_FRAME_JPEG_QUALITY: ${REPRESENTATIVE_FRAME_JPEG_QUALITY:-85}
      REPRESENTATIVE_FRAME_DEDUP_TOLERANCE_SECONDS: ${REPRESENTATIVE_FRAME_DEDUP_TOLERANCE_SECONDS:-0.5}
      LOG_LEVEL: ${LOG_LEVEL:-INFO}
    ports: ["${API_PORT:-8012}:8000"]
    volumes:
      - "./storage:/data/storage"
      - "media-indexer-model-cache:/data/models"
    depends_on:
      db:
        condition: service_healthy
volumes:
  media-indexer-db-data:
  media-indexer-model-cache:
