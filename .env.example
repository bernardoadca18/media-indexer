POSTGRES_USER=media_indexer
POSTGRES_PASSWORD=media_indexer
POSTGRES_DB=media_indexer
DATABASE_URL=postgresql+asyncpg://media_indexer:media_indexer@db:5432/media_indexer
API_PORT=8012
STORAGE_ROOT=/data/storage
WORKER_ENABLED=true
FFPROBE_BINARY=ffprobe
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
JOB_STALE_TIMEOUT_SECONDS=300
JOB_HEARTBEAT_INTERVAL_SECONDS=30
JOB_MAX_ATTEMPTS=3
TRANSCRIPTION_BATCH_SIZE=25
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
WHISPER_WORD_TIMESTAMPS=true
FFMPEG_BINARY=ffmpeg
VISUAL_INDEX_BATCH_SIZE=25
SCENE_DETECTION_ENABLED=true
SCENE_DETECTOR=ffmpeg_scdet
SCENE_THRESHOLD=10.0
REPRESENTATIVE_FRAME_INTERVAL_SECONDS=10.0
REPRESENTATIVE_FRAME_WIDTH=640
REPRESENTATIVE_FRAME_FORMAT=jpeg
REPRESENTATIVE_FRAME_JPEG_QUALITY=85
REPRESENTATIVE_FRAME_DEDUP_TOLERANCE_SECONDS=0.5
